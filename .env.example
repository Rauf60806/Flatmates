# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Database (from Dashboard → Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Supabase Service Role Key (from Dashboard → Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
ADMIN_EMAIL="admin@flatmates.local"
ADMIN_PASSWORD="AdminTemporaryPassword123!"
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
PORT=5000
