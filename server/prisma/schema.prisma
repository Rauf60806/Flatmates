datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  member
}

enum ItemType {
  individual
  group
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(member)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  paidItems    Item[]        @relation("PaidByUser")
  splits       Split[]
  sentSettles  Settlement[]  @relation("SettlementFrom")
  recvSettles  Settlement[]  @relation("SettlementTo")
}

model Item {
  id        String    @id @default(uuid())
  name      String
  price     Int       // Unit price in minor units (cents / paise)
  quantity  Int       @default(1)
  total     Int       // Total = price * quantity
  type      ItemType  @default(group)
  paidById  String
  paidBy    User      @relation("PaidByUser", fields: [paidById], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  splits    Split[]

  @@index([createdAt])
  @@index([name])
}

model Split {
  id      String @id @default(uuid())
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  share   Int    // Exact share in minor units

  @@unique([itemId, userId])
}

model Settlement {
  id         String   @id @default(uuid())
  fromUserId String
  fromUser   User     @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("SettlementTo", fields: [toUserId], references: [id])
  amount     Int      // Amount paid in minor units
  createdAt  DateTime @default(now())
}
